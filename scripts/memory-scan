#!/bin/sh
# Read-only facts about one memory folder. Never writes, moves or deletes.
# Used by hooks/check-stale and by /checkup, so both read stamps the same way.
#
#   memory-scan stamps <dir>   one line per topic file (never MEMORY.md,
#                              never .trash/), tab-separated:
#                                OVERDUE    <file>  <date>   date before today
#                                STAMPED    <file>  <date>   today or later
#                                BADSTAMP   <file>  <value>  not YYYY-MM-DD
#                                UNSTAMPED  <file>
#                              Only a top-level `review-after:` line inside
#                              the frontmatter counts; body text does not.
#                              A well-formed stamp wins over a malformed one
#                              in the same file.
#   memory-scan index <dir>    MEMORY.md size against the load limit
#                              (200 lines / 25 KB), index lines whose target
#                              file is missing, topic files no line points to.
#
# Exit 0 on success, 2 on a usage error or a missing folder. The date used
# as "today" can be fixed with MEMORY_SCAN_TODAY=YYYY-MM-DD (tests).

LIMIT_LINES=200
LIMIT_BYTES=25600

cmd="$1"; dir="${2%/}"
if [ -z "$cmd" ] || [ -z "$dir" ]; then
  echo "usage: memory-scan stamps|index <memory folder>" >&2; exit 2
fi
[ -d "$dir" ] || { echo "memory-scan: no such folder: $dir" >&2; exit 2; }
today="${MEMORY_SCAN_TODAY:-$(date +%Y-%m-%d)}" || exit 2

# Any topic files at all? (an unmatched glob stays literal)
has_md=0
for f in "$dir"/*.md; do [ -f "$f" ] && has_md=1 && break; done

stamps() {
  [ "$has_md" -eq 1 ] || return 0
  awk -v today="$today" '
    function flush() {
      if (file == "" || reported) return
      if (hasbad) printf "BADSTAMP\t%s\t%s\n", file, bad
      else printf "UNSTAMPED\t%s\n", file
    }
    FNR==1 {
      flush()
      n=split(FILENAME,p,"/"); file=p[n]; reported=0; fm=0; done=0; hasbad=0
      if (file == "MEMORY.md") { reported=1; done=1 }
      else if ($0 !~ /^---/) done=1
    }
    done { next }
    { sub(/\r$/,"") }
    /^---[[:space:]]*$/ { fm++; if (fm>=2) done=1; next }
    fm==1 && /^review-after:/ {
      v=$0; sub(/^review-after:[[:space:]]*/,"",v); sub(/[[:space:]]+$/,"",v)
      if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) {
        printf "%s\t%s\t%s\n", (v < today ? "OVERDUE" : "STAMPED"), file, v
        done=1; reported=1
      } else if (!hasbad) { hasbad=1; bad=v }
    }
    END { flush() }' "$dir"/*.md
}

# "F <file>" per topic file and "N <slug> <file>" per frontmatter name.
# The F lines come from the shell glob, so an empty file still counts.
listing() {
  echo "X"
  [ "$has_md" -eq 1 ] || return 0
  for f in "$dir"/*.md; do
    [ "${f##*/}" = "MEMORY.md" ] || printf 'F\t%s\n' "${f##*/}"
  done
  awk '
    FNR==1 {
      n=split(FILENAME,p,"/"); file=p[n]; fm=0; done=0
      if (file == "MEMORY.md") { done=1; next }
      if ($0 !~ /^---/) done=1
    }
    done { next }
    { sub(/\r$/,"") }
    /^---[[:space:]]*$/ { fm++; if (fm>=2) done=1; next }
    fm==1 && /^name:/ {
      v=$0; sub(/^name:[[:space:]]*/,"",v); sub(/[[:space:]]+$/,"",v)
      gsub(/^["\047]|["\047]$/,"",v)
      if (v != "") printf "N\t%s\t%s\n", v, file
    }' "$dir"/*.md
}

index() {
  idx="$dir/MEMORY.md"
  [ -f "$idx" ] || { echo "memory-scan: no MEMORY.md in $dir" >&2; exit 2; }
  bytes=$(wc -c < "$idx" | tr -d ' ')
  listing | LC_ALL=C awk -F '\t' -v today="$today" -v bytes="$bytes" \
      -v maxl="$LIMIT_LINES" -v maxb="$LIMIT_BYTES" '
    function note(t) { hit = (hit == "" ? t : hit ", " t) }
    function file_target(t) {
      if (t ~ /:\/\// || t ~ /^(#|mailto:)/) return
      sub(/^[[:space:]]*</,"",t); sub(/>.*$/,"",t)      # (<file.md>)
      sub(/[[:space:]]+["\047(].*$/,"",t)                # (file.md "title")
      sub(/#.*$/,"",t); sub(/^\.\//,"",t)
      if (t !~ /\.md$/ || t ~ /\// || t == "MEMORY.md") return
      if (t in exists) ref[t]=1; else note(t)
    }
    function slug_target(s) {
      sub(/\|.*$/,"",s)
      if (s in slug) ref[slug[s]]=1
      else if ((s ".md") in exists) ref[s ".md"]=1
      else note("[[" s "]]")
    }
    NR==FNR {
      if ($1 == "F") { exists[$2]=1; order[++nf]=$2 }
      else if ($1 == "N") slug[$2]=$3
      next
    }
    {
      ln++; cum += length($0) + 1
      if (!first && (ln > maxl || cum > maxb)) first=ln
      line=$0; sub(/\r$/,"",line); hit=""
      rest=line
      while (match(rest, /\]\([^)]*\)/)) {
        t=substr(rest, RSTART+2, RLENGTH-3); rest=substr(rest, RSTART+RLENGTH)
        file_target(t)
      }
      rest=line
      while (match(rest, /\[\[[^]]*\]\]/)) {
        t=substr(rest, RSTART+2, RLENGTH-4); rest=substr(rest, RSTART+RLENGTH)
        slug_target(t)
      }
      if (hit != "") { dl[++nd]=ln; dt[nd]=hit }
    }
    END {
      # cum counts a newline per line; trust the real size for a file
      # without a trailing newline.
      if (first && ln <= maxl && bytes <= maxb) first=0
      pl = ln * 100 / maxl; pb = bytes * 100 / maxb; pct = int(pl > pb ? pl : pb)
      printf "today: %s\n", today
      printf "index: %d lines, %.1f KB (%d bytes) of %d lines / %d KB\n", ln, bytes/1024, bytes, maxl, maxb/1024
      if (first) {
        printf "status: OVER LIMIT\n"
        printf "never-load: lines %d to %d\n", first, ln
      } else if (pct >= 80) printf "status: NEAR LIMIT (%d%%)\n", pct
      else printf "status: OK (%d%%)\n", pct
      no=0
      for (i=1; i<=nf; i++) if (!(order[i] in ref)) orph[++no]=order[i]
      printf "orphans: %d\n", no
      for (i=1; i<=no; i++) printf "orphan: %s\n", orph[i]
      printf "dangling: %d\n", nd
      for (i=1; i<=nd; i++) printf "dangling-line: %d -> %s\n", dl[i], dt[i]
    }' - "$idx"
}

case "$cmd" in
  stamps) stamps ;;
  index)  index ;;
  *) echo "memory-scan: unknown command: $cmd" >&2; exit 2 ;;
esac
